{
  // VS Code debug configs. Set breakpoints (click left of a line number) then
  // pick a config in the Run & Debug panel (Cmd+Shift+D) and press F5.
  "version": "0.2.0",
  "configurations": [
    {
      // Debug the Streamlit app. Streamlit must be launched as a MODULE, not as
      // a plain script, or breakpoints never bind. "justMyCode": false lets you
      // step into langchain internals too.
      "name": "Debug Streamlit app.py",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "${workspaceFolder}/app.py"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      // Debug the standalone pipeline checks (Layer 0 + embeddings).
      "name": "Debug debug.py (env checks)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/debug.py",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      // Debug ingestion. Edit the PDF path in "args" before running.
      "name": "Debug debug.py ingest <PDF>",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/debug.py",
      "args": ["ingest", "${workspaceFolder}/sample.pdf"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      // Debug retrieval + generation. Edit the question in "args" before running.
      "name": "Debug debug.py query <question>",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/debug.py",
      "args": ["query", "What is this document about?"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
     {
      // Debug the embeddings lesson. "python" pins the project venv so the
      // debugger never falls back to a system/Homebrew interpreter.
      "name": "Debug 01_embeddings",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/learn/01_embeddings.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      // Debug the embeddings lesson. "python" pins the project venv so the
      // debugger never falls back to a system/Homebrew interpreter.
      "name": "Debug 01_retrieval.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/learn/02_retrieval.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false
    },
     {
      // Debug the embeddings lesson. "python" pins the project venv so the
      // debugger never falls back to a system/Homebrew interpreter.
      "name": "Debug 01_rag.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/learn/03_rag.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
